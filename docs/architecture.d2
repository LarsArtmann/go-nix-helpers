direction: right

consumer_flake: Consumer flake.nix {
  shape: package
  style.fill: "#e3e9fd"
  inputs: 3 Inputs {
    shape: text
    style.fill: transparent
    nixpkgs
    flake-parts
    go-nix-helpers
  }
  config: "go-standard = { pname = ...; }" {
    shape: text
    style.fill: transparent
  }
}

module: go-standard module {
  shape: package
  style.fill: "#edf0fd"

  options: Typed Options {
    shape: rectangle
    style.fill: "#f7f8fe"
    pname
    vendorHash
    deps
    systems
    enableCheck
    buildFlags
    privateGlobPattern
    enableNixfmt
    enableShfmt
    container
    "+43 more"
  }

  config: Config Pipeline {
    shape: rectangle
    style.fill: "#f7f8fe"
    perSystem
    flake.overlays
    systems
  }
}

prepared_source: mkPreparedSource {
  shape: package
  style.fill: "#e3e9fd"
  copies_deps: "Copies deps into _local_deps/"
  injects: "Injects replace directives"
  discovers: "Auto-discovers sub-modules"
  validates: "Validates private requires"
}

pure_functions: pure-functions.nix {
  shape: package
  style.fill: "#e3e9fd"
  stripVersionSuffix: "Strips /vN from module paths"
  repoName: "Extracts repo name from module path"
}

container_asm: container.nix {
  shape: package
  style.fill: "#e3e9fd"
  imageConfig: "OCI image config (user, env, labels, ports)"
  volumes: "mkVolumeDirs (user-owned volume dirs)"
  structureCheck: "jq gate over image.json"
  backend: "nix2container (bundled)"
}

outputs: Flake Outputs {
  shape: package
  style.fill: "#edf0fd"
  packages.default
  "packages.<pname>-image"
  apps.default/test/lint/fmt
  "apps.<pname>-image-load/push"
  devShells.default/ci
  checks.format/build
  "checks.container-structure"
  overlays.default
  treefmt
}

consumer_flake -> module: "imports"
module.options -> module.config
module.config -> prepared_source: "when deps set"
module.config -> container_asm: "when container.enable"
pure_functions -> prepared_source: "imported by"
prepared_source -> outputs: "prepared src"
container_asm -> outputs: "OCI image outputs (Linux)"
module.config -> outputs: "packages, apps, ..."
